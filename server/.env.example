# Copy to .env (git-ignored) and fill in. Names only here, never values.

# Robot link (Alex). Leave ROBOT_HOST unset to use the mock robot on this laptop.
ROBOT_HOST=balancebot.local
ROBOT_PORT=4210

# Agent (Grant). Claude by default, Gemini swappable (decision 0037).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Voice (Grant): Cartesia text-to-speech. Without CARTESIA_API_KEY the phone uses Safari's built-in voice.
# Pick Miguel's voice in Cartesia's voice library and put its id here.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_SPEED=

# Hearing (Grant): Cartesia speech-to-text for the phone's mic (same CARTESIA_API_KEY).
# Model (default ink-2) and comma-separated words to listen for (default Miguel).
CARTESIA_STT_MODEL=
CARTESIA_STT_KEYTERMS=

# Local hearing (#81): speech-to-text on this Mac, no network (Parakeet + Silero VAD, app/speech/stt_local.py).
# cartesia (default) or local. local needs `uv sync --group local` once (a plain `uv sync` removes it again)
# and the model in the Hugging Face cache; without them the log says why and Cartesia is used.
# The keyterms above also fix local near misses ("Migel" -> "Miguel").
MIGUEL_STT=
# Hugging Face id or a local folder (default mlx-community/parakeet-tdt-0.6b-v3)
MIGUEL_STT_MODEL=
# Milliseconds of silence that end a turn (default 600)
MIGUEL_STT_END_SILENCE_MS=
# Seconds of speech between running transcripts, for the wake word mid-sentence (default 0.7)
MIGUEL_STT_PARTIAL_S=
# Longest turn in seconds; longer speech is cut into several turns (default 15)
MIGUEL_STT_MAX_S=
# Silero speech probability that counts as speech, 0 to 1 (default 0.5)
MIGUEL_STT_VAD_THRESHOLD=
# 1 at the venue: Hugging Face never tries the network (local hearing reads its model from the cache anyway)
HF_HUB_OFFLINE=

# Guardian channel (#54): the family app's token for /agent/* from another machine
# (Authorization: Bearer <token>). Empty: only this laptop can talk to the agent.
GUARDIAN_TOKEN=

# Family app (app/family.py, contract/web/family.md). Without FAMILY_TOKEN only this laptop can connect.
FAMILY_TOKEN=
FAMILY_RESIDENT_NAME=Margaret
FAMILY_RESIDENT_SHORT=Mom
FAMILY_TZ=America/New_York
# Possible-fall detection (pose + a Claude check); 0 turns it off
FALL_DETECT=1
# Miguel's memory (SQLite); default server/miguel.db
MIGUEL_DB=

# Swap forward and backward for every drive command (1 = swapped); --reverse-drive / --no-reverse-drive override
ROBOT_REVERSE_DRIVE=

# Voice (turn-taking, delay)
# Seconds Miguel listens without his name after he asks a question
MIGUEL_ANSWER_WINDOW_S=4
# Seconds he listens after a tap on his face, or after "Miguel" alone
MIGUEL_TAP_LISTEN_S=8
# 1 = per-message effort (keeps the prompt cache); 0 = top-level effort
MIGUEL_EFFORT_PER_MESSAGE=1
# Seconds between prompt-cache warm-ups while idle; 0 = off
MIGUEL_LLM_KEEPALIVE_S=240
# 1 = the phone plays Miguel's voice while it streams in (untested on iPhone); 0 = whole lines
MIGUEL_TTS_STREAM=0

# Cartesia voice requests at once (the plan's concurrency limit); 1 = one at a time, in order
CARTESIA_MAX_CONCURRENT=1

# Local voice (#81): cartesia (default) or local (Kokoro-82M on this Mac, no network).
# local needs `uv sync --group local` and `uv run hf download mlx-community/Kokoro-82M-bf16`;
# if the model is missing the server says so and uses Cartesia (or Safari's voice without a key).
MIGUEL_TTS=cartesia
# Kokoro voice name (a file in the model's voices/ folder); default af_heart
MIGUEL_KOKORO_VOICE=
