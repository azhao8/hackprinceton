# Copy to .env.local to change. Restart `npm run dev` after editing.

# WebSocket URL of the server's web API. Leave unset to use the built-in
# sample telemetry (no server needed).
# NEXT_PUBLIC_SERVER_WS_URL=ws://localhost:8000/ws

# ---- Family app (/family; contract/web/family.md) ----

# "demo" runs the seeded demo day in the browser (no server) and enables the hidden
# demo panel. Unset (or "server"): the app talks to the server's family WebSocket.
# Adding ?demo to the page URL does the same for one visit.
# NEXT_PUBLIC_FAMILY_SOURCE=demo

# The server's family WebSocket. Unset: the server on the host that served the page,
# ws://<host>:8080/family/ws, or wss://<host>:8443/family/ws when the page is https.
# Photos (/family/media/<id>) load from the same host and port, over http(s).
# NEXT_PUBLIC_FAMILY_WS_URL=wss://<tunnel-host>/family/ws

# The shared family token: the same value as FAMILY_TOKEN in server/.env (one token
# for the weekend; per-person tokens are T-22). It ships in the page's JavaScript.
# NEXT_PUBLIC_FAMILY_TOKEN=
