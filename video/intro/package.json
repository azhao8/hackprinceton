    "@fontsource/sora": "^5.3.0",
    "@remotion/cli": "^4.0.543",
    "opentype.js": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.543",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
